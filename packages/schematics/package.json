{
  "name": "ng-icon-forge",
  "version": "0.0.0",
  "description": "ng add ng-icon-forge — generates Angular PWA icon assets from a source SVG and merges them into manifest.webmanifest, ngsw-config.json, and index.html.",
  "license": "MIT",
  "author": "Oliver Fink",
  "homepage": "https://github.com/olifink/ng-icon-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olifink/ng-icon-forge.git",
    "directory": "packages/schematics"
  },
  "bugs": {
    "url": "https://github.com/olifink/ng-icon-forge/issues"
  },
  "keywords": [
    "angular",
    "angular-cli",
    "schematics",
    "ng-add",
    "pwa",
    "icons",
    "favicon",
    "manifest",
    "svg",
    "maskable"
  ],
  "type": "module",
  "schematics": "./collection.json",
  "ng-add": {
    "save": false
  },
  "files": [
    "collection.json",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@angular-devkit/schematics": "^22.0.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "@schematics/angular": "^22.0.8",
    "parse5-html-rewriting-stream": "^8.0.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.8",
    "@ng-icon-forge/core": "0.0.0",
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "@angular/cli": "^22.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/cli": {
      "optional": true
    }
  }
}
